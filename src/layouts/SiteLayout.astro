---
import { siteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  openGraphType?: 'website' | 'article';
  articlePublishedTime?: string;
  extraStructuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  openGraphType = 'website',
  articlePublishedTime,
  extraStructuredData,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.domain).href;
const socialImage = `${siteConfig.domain}/og-image.png`;
const socialImageAlt = 'Hernani Junior — engenheiro de software com foco em backend, APIs e integração de sistemas.';
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteConfig.domain}/#hernani`,
  name: siteConfig.name,
  jobTitle: 'Software Engineer',
  url: siteConfig.domain,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Belo Horizonte',
    addressRegion: 'Minas Gerais',
    addressCountry: 'BR',
  },
  sameAs: [siteConfig.links.github, siteConfig.links.linkedin],
  knowsAbout: [
    'Software engineering',
    'Backend development',
    'Node.js',
    'TypeScript',
    'NestJS',
    'REST API design',
    'System integration',
    'Distributed systems',
    'Asynchronous processing',
    'Software observability',
  ],
};
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f3ed" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={openGraphType} />
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {extraStructuredData && <script type="application/ld+json" set:html={JSON.stringify(extraStructuredData).replace(/</g, '\\u003c')} />}
    <title>{title}</title>
  </head>
  <body id="top">
    <slot />
  </body>
</html>
