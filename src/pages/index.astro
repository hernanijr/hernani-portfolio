---
import ProjectCaseStudy from '../components/ProjectCaseStudy.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { expertiseAreas, experiments, projects, siteConfig, technologies } from '../data/site';

const title = 'Hernani Junior — Engenheiro de Software | Backend, APIs e Integrações';
const description =
  'Engenheiro de software em Belo Horizonte com foco em backend, APIs, integração de sistemas e aplicações confiáveis. Node.js, TypeScript e NestJS.';
---

<SiteLayout title={title} description={description}>
  <a class="skip-link" href="#main">Pular para o conteúdo</a>
  <SiteHeader />
  <main id="main">
    <section class="hero section-wrap" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> SOFTWARE ENGINEER · BELO HORIZONTE, BR</p>
        <h1>Engenharia de software com foco em <em>backend, APIs e integrações.</em></h1>
        <p class="hero__description">
          Desenvolvo e evoluo serviços, aplicações e integrações, com atenção à confiabilidade, qualidade de código e operação dos sistemas.
        </p>
        <div class="hero__actions">
          <a class="button button--primary" href="#projects">Ver projetos <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="#contact">Contato profissional <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-visual__heading">
          <span>ENGENHARIA DE SOFTWARE</span>
          <span aria-hidden="true">01 — 03</span>
        </div>
        <div class="solution-map">
          <div class="solution-map__item solution-map__item--start">
            <span>01</span><strong>APIs</strong><small>contratos claros</small>
          </div>
          <span class="solution-map__line" aria-hidden="true"></span>
          <div class="solution-map__item solution-map__item--middle">
            <span>02</span><strong>Integrações</strong><small>fluxos resilientes</small>
          </div>
          <span class="solution-map__line" aria-hidden="true"></span>
          <div class="solution-map__item solution-map__item--end">
            <span>03</span><strong>Sistemas</strong><small>confiáveis em produção</small>
          </div>
        </div>
        <p class="hero-visual__note">Backend, integração<br />e evolução contínua.</p>
        <span class="hero-visual__mark" aria-hidden="true">H.</span>
      </div>
      <a class="hero__scroll" href="#about"><span aria-hidden="true">↓</span> UM POUCO SOBRE MIM</a>
    </section>

    <section class="intro section-wrap section-wrap--ruled" id="about" aria-labelledby="about-title">
      <div class="section-label"><span>01</span><span>QUEM SOU</span></div>
      <div class="intro__content">
        <p class="eyebrow">ENGENHEIRO DE SOFTWARE · BACKEND E FULL-STACK</p>
        <h2 id="about-title">Construindo sistemas que conectam <em>serviços, dados e pessoas.</em></h2>
        <div class="intro__text">
          <p>
            Sou Hernani, engenheiro de software em Belo Horizonte, com foco em backend, APIs e integração de sistemas. Trabalho principalmente com Node.js, TypeScript e NestJS.
          </p>
          <p>
            Ao longo da carreira, atuei em aplicações corporativas, processamento assíncrono, integrações, observabilidade e evolução de sistemas em produção. Também tenho experiência full-stack com React e Next.js.
          </p>
        </div>
      </div>
    </section>

    <section class="expertise section-wrap" id="expertise" aria-labelledby="expertise-title">
      <div class="section-label"><span>02</span><span>ÁREAS DE ATUAÇÃO</span></div>
      <div class="section-heading">
        <div>
          <p class="eyebrow">FOCO TÉCNICO</p>
          <h2 id="expertise-title">Backend como base. Integração e confiabilidade como parte do trabalho.</h2>
        </div>
        <p>Uma visão de engenharia que considera contratos, dados, operação e manutenção — não apenas a implementação de uma funcionalidade.</p>
      </div>
      <div class="expertise-list">
        {
          expertiseAreas.map((area) => (
            <article class="expertise-item">
              <span class="expertise-item__number">{area.number}</span>
              <div class="expertise-item__main">
                <h3>{area.title}</h3>
                <p>{area.description}</p>
              </div>
              <ul>
                {area.examples.map((example) => <li>{example}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="projects-section section-wrap section-wrap--dark" id="projects" aria-labelledby="projects-title">
      <div class="section-label"><span>03</span><span>PROJETO EM DESTAQUE</span></div>
      <div class="section-heading section-heading--dark">
        <div>
          <p class="eyebrow">PROJETO REAL, DECISÕES TÉCNICAS</p>
          <h2 id="projects-title">Um recorte de engenharia aplicada.</h2>
        </div>
        <p>Um estudo de caso sobre requisitos, decisões de implementação, fluxo editorial e entrega de um produto web.</p>
      </div>
      {projects.map((project, index) => (
        <ProjectCaseStudy project={project} index={index + 1} total={projects.length} />
      ))}
    </section>

    <section class="experiments section-wrap section-wrap--tint" id="experiments" aria-labelledby="experiments-title">
      <div class="section-label"><span>04</span><span>EXPERIMENTOS E ESTUDOS</span></div>
      <div class="section-heading">
        <div>
          <p class="eyebrow">PROTÓTIPOS E EXPLORAÇÕES TÉCNICAS</p>
          <h2 id="experiments-title">Explorar ideias também faz parte de aprender engenharia.</h2>
        </div>
        <p>Projetos pessoais em diferentes estágios. São experimentos técnicos, não produtos apresentados como soluções prontas para produção.</p>
      </div>
      <div class="experiment-grid">
        {
          experiments.map((experiment) => (
            <article class="experiment-card">
              <div class="experiment-card__meta">
                <span>{experiment.status}</span>
                <span aria-hidden="true">↗</span>
              </div>
              <h3>{experiment.name}</h3>
              <p>{experiment.summary}</p>
              <ul aria-label={`Tecnologias de ${experiment.name}`}>
                {experiment.stack.map((technology) => <li>{technology}</li>)}
              </ul>
              <div class="experiment-card__links">
                {experiment.backendRepository ? (
                  <>
                    <a href={experiment.repository} target="_blank" rel="noreferrer">Frontend <span aria-hidden="true">↗</span></a>
                    <a href={experiment.backendRepository} target="_blank" rel="noreferrer">Backend <span aria-hidden="true">↗</span></a>
                  </>
                ) : (
                  <a href={experiment.repository} target="_blank" rel="noreferrer">Ver repositório <span aria-hidden="true">↗</span></a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="technology section-wrap" id="technology" aria-labelledby="technology-title">
      <div class="section-label"><span>05</span><span>STACK E PRÁTICAS</span></div>
      <div class="section-heading">
        <div>
          <p class="eyebrow">FERRAMENTAS E FUNDAMENTOS</p>
          <h2 id="technology-title">Tecnologia escolhida de acordo com o problema.</h2>
        </div>
        <p>O foco está em construir soluções compreensíveis, testáveis e operáveis, usando ferramentas adequadas a cada contexto.</p>
      </div>
      <div class="technology-list">
        {
          technologies.map((group) => (
            <article class="technology-group">
              <div>
                <h3>{group.name}</h3>
                <p>{group.description}</p>
              </div>
              <ul aria-label={`Tecnologias para ${group.name}`}>
                {group.tools.map((tool) => <li>{tool}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="contact section-wrap" id="contact" aria-labelledby="contact-title">
      <div class="section-label"><span>06</span><span>CONTATO PROFISSIONAL</span></div>
      <div class="contact__content">
        <p class="eyebrow">CONVERSAS SOBRE ENGENHARIA</p>
        <h2 id="contact-title">Vamos conversar sobre <em>software e tecnologia.</em></h2>
        <p>Aberto a conversas sobre oportunidades em engenharia de software, desafios técnicos e troca de conhecimento com outras pessoas da área.</p>
        <div class="contact__links">
          <a class="button button--primary" href={siteConfig.links.contact} data-analytics-event="contact_click">
            Enviar e-mail <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={siteConfig.links.linkedin} target="_blank" rel="noreferrer" data-analytics-event="linkedin_click">LinkedIn <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={siteConfig.links.github} target="_blank" rel="noreferrer" data-analytics-event="github_click">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="contact__aside">
        <span class="contact__asterisk" aria-hidden="true">✳</span>
        <p>Baseado em<br /><strong>Belo Horizonte, MG, Brasil</strong></p>
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="site-footer__main">
      <a class="wordmark wordmark--footer" href="#top">
        <span class="wordmark__symbol" aria-hidden="true">h.</span>
        <span>{siteConfig.name}<small>SOFTWARE ENGINEERING</small></span>
      </a>
      <p>Engenheiro de software com foco em backend, APIs e integração de sistemas.</p>
      <div class="site-footer__links">
        <a href={siteConfig.links.github} target="_blank" rel="noreferrer" data-analytics-event="github_click">GitHub <span aria-hidden="true">↗</span></a>
        <a href={siteConfig.links.linkedin} target="_blank" rel="noreferrer" data-analytics-event="linkedin_click">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href={siteConfig.links.email} data-analytics-event="contact_click">E-mail <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="site-footer__legal">
      <span>© {new Date().getFullYear()} {siteConfig.name}. Todos os direitos reservados.</span>
      <a href="#top">Voltar ao início ↑</a>
    </div>
  </footer>
</SiteLayout>
