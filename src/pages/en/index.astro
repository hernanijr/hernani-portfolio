---
import ProjectCaseStudy from '../../components/ProjectCaseStudy.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { siteConfig } from '../../data/site';
import { englishContent as content } from '../../data/en';

const title = content.metadata.homeTitle;
const description = content.metadata.homeDescription;
const alternates = [
  { locale: 'pt-BR' as const, url: siteConfig.domain + '/' },
  { locale: 'en' as const, url: siteConfig.domain + '/en/' },
];
---

<SiteLayout title={title} description={description} locale="en" alternates={alternates}>
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader locale="en" languageHref="/" />
  <main id="main">
    <section class="hero section-wrap" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> {content.home.heroEyebrow}</p>
        <h1 id="hero-title">{content.home.heroTitle}<em>{content.home.heroEmphasis}</em></h1>
        <p class="hero__description">{content.home.heroDescription}</p>
        <div class="hero__actions">
          <a class="button button--primary" href="#projects">{content.home.viewProjects} <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="#contact">{content.home.professionalContact} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-visual__heading"><span>{content.home.visualHeading}</span><span aria-hidden="true">01 — 03</span></div>
        <div class="solution-map">
          <div class="solution-map__item solution-map__item--start"><span>01</span><strong>APIs</strong><small>clear contracts</small></div>
          <span class="solution-map__line" aria-hidden="true"></span>
          <div class="solution-map__item solution-map__item--middle"><span>02</span><strong>Integrations</strong><small>resilient workflows</small></div>
          <span class="solution-map__line" aria-hidden="true"></span>
          <div class="solution-map__item solution-map__item--end"><span>03</span><strong>Systems</strong><small>reliable in production</small></div>
        </div>
        <p class="hero-visual__note">{content.home.visualNote}</p>
        <span class="hero-visual__mark" aria-hidden="true">H.</span>
      </div>
      <a class="hero__scroll" href="#about"><span aria-hidden="true">↓</span> {content.home.scrollLabel}</a>
    </section>

    <section class="intro section-wrap section-wrap--ruled" id="about" aria-labelledby="about-title">
      <div class="section-label"><span>01</span><span>ABOUT</span></div>
      <div class="intro__content">
        <p class="eyebrow">{content.home.aboutEyebrow}</p>
        <h2 id="about-title">{content.home.aboutTitle}<em>{content.home.aboutEmphasis}</em></h2>
        <div class="intro__text">
          {content.home.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="experience section-wrap" id="experience" aria-labelledby="experience-title">
      <div class="section-label"><span>02</span><span>{content.home.experienceLabel}</span></div>
      <div class="experience__content">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{content.home.experienceEyebrow}</p>
            <h2 id="experience-title">{content.home.experienceTitle}</h2>
          </div>
          <p>{content.home.experienceIntro}</p>
        </div>
        <article class="experience-item">
          <p class="experience-item__period">{content.home.currentPeriod}</p>
          <div class="experience-item__content">
            <p class="eyebrow">{content.home.currentRole}</p>
            <h3>Grupo Boticário</h3>
            <p>{content.home.currentDescription}</p>
            <ul aria-label={content.home.technologiesUsed}>
              {['Node.js', 'TypeScript', 'NestJS', 'React'].map((technology) => <li>{technology}</li>)}
            </ul>
          </div>
        </article>
        <div class="experience-previous">
          <p class="eyebrow">{content.home.previousExperience}</p>
          <ul>
            {['FCamara', 'Loggi', 'Kunumi', 'Ecobonuz', 'Seedz', 'Montreal Informática'].map((company) => <li>{company}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="expertise section-wrap" id="expertise" aria-labelledby="expertise-title">
      <div class="section-label"><span>03</span><span>{content.home.expertiseLabel}</span></div>
      <div class="section-heading">
        <div>
          <p class="eyebrow">{content.home.expertiseEyebrow}</p>
          <h2 id="expertise-title">{content.home.expertiseTitle}</h2>
        </div>
        <p>{content.home.expertiseIntro}</p>
      </div>
      <div class="expertise-list">
        {content.home.expertiseAreas.map((area) => (
          <article class="expertise-item">
            <div class="expertise-item__main"><h3>{area.title}</h3><p>{area.description}</p></div>
            <ul>{area.examples.map((example) => <li>{example}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <section class="projects-section section-wrap section-wrap--dark" id="projects" aria-labelledby="projects-title">
      <div class="section-label"><span>04</span><span>{content.home.projectsLabel}</span></div>
      <div class="section-heading section-heading--dark">
        <div>
          <p class="eyebrow">{content.home.projectsEyebrow}</p>
          <h2 id="projects-title">{content.home.projectsTitle}</h2>
        </div>
        <p>{content.home.projectsIntro}</p>
      </div>
      <ProjectCaseStudy project={content.home.project} index={1} total={1} locale="en" />
    </section>



    <section class="technology section-wrap" id="technology" aria-labelledby="technology-title">
      <div class="section-label"><span>05</span><span>{content.home.technologyLabel}</span></div>
      <div class="section-heading">
        <div>
          <p class="eyebrow">{content.home.technologyEyebrow}</p>
          <h2 id="technology-title">{content.home.technologyTitle}</h2>
        </div>
        <p>{content.home.technologyIntro}</p>
      </div>
      <div class="technology-list">
        {content.home.technologies.map((group) => (
          <article class="technology-group">
            <div><h3>{group.name}</h3><p>{group.description}</p></div>
            <ul aria-label={'Technologies for ' + group.name}>{group.tools.map((tool) => <li>{tool}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <section class="contact section-wrap" id="contact" aria-labelledby="contact-title">
      <div class="section-label"><span>06</span><span>{content.home.contactLabel}</span></div>
      <div class="contact__content">
        <p class="eyebrow">{content.home.contactEyebrow}</p>
        <h2 id="contact-title">{content.home.contactTitle}<em>{content.home.contactEmphasis}</em></h2>
        <p>{content.home.contactDescription}</p>
        <div class="contact__links">
          <a class="button button--primary" href={siteConfig.links.contact} data-analytics-event="contact_click">{content.home.sendEmail} <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={siteConfig.links.linkedin} target="_blank" rel="noopener noreferrer" data-analytics-event="linkedin_click">LinkedIn <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={siteConfig.links.github} target="_blank" rel="noopener noreferrer" data-analytics-event="github_click">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="contact__aside">
        <span class="contact__asterisk" aria-hidden="true">✳</span>
        <p>{content.home.location}<br /><strong>{content.home.locationValue}</strong></p>
      </div>
    </section>
  </main>
  <SiteFooter locale="en" />
</SiteLayout>
