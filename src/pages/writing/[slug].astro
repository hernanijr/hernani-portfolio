---
import { getCollection, render } from 'astro:content';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { siteConfig } from '../../data/site';
import { getWritingPath, getWritingSlug } from '../../data/i18n';

export async function getStaticPaths() {
  const allPosts = await getCollection('writing', ({ data }) => data.draft !== true);
  const posts = allPosts.filter((post) => post.data.locale === 'pt-BR');

  return posts.map((post) => {
    const slug = getWritingSlug(post.id, post.data.slug);
    const translated = allPosts.find((candidate) =>
      candidate.data.locale === 'en' && getWritingSlug(candidate.id, candidate.data.slug) === slug
    );
    const alternateUrls = [
      { locale: 'pt-BR' as const, url: siteConfig.domain + getWritingPath('pt-BR', slug) },
      ...(translated ? [{ locale: 'en' as const, url: siteConfig.domain + getWritingPath('en', slug) }] : []),
    ];

    return {
      params: { slug },
      props: {
        post,
        languageHref: translated ? getWritingPath('en', slug) : '/en/writing/',
        alternateUrls,
      },
    };
  });
}

const { post, languageHref, alternateUrls } = Astro.props;
const { Content } = await render(post);
const wordCount = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 220));
const slug = getWritingSlug(post.id, post.data.slug);
const canonicalUrl = new URL(getWritingPath('pt-BR', slug), siteConfig.domain).href;
const dateModified = post.data.updatedDate ?? post.data.pubDate;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': canonicalUrl + '#article',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  headline: post.data.title,
  description: post.data.description,
  image: siteConfig.domain + '/og-image.png',
  datePublished: post.data.pubDate.toISOString(),
  dateModified: dateModified.toISOString(),
  author: { '@id': siteConfig.domain + '/#hernani', name: siteConfig.name },
  publisher: { '@id': siteConfig.domain + '/#hernani', name: siteConfig.name },
  keywords: post.data.tags,
};

const title = post.data.title + ' | Hernani Junior';
---

<SiteLayout title={title} description={post.data.description} locale="pt-BR" alternates={alternateUrls} openGraphType="article" articlePublishedTime={post.data.pubDate.toISOString()} extraStructuredData={articleSchema}>
  <a class="skip-link" href="#main">Pular para o conteúdo</a>
  <SiteHeader locale="pt-BR" languageHref={languageHref} />
  <main id="main">
    <article class="writing-article-page section-wrap">
      <div class="writing-article">
        <a class="writing-back" href="/writing/">← Voltar para Writing</a>
        <header class="writing-article__header">
          <p class="eyebrow">ESCRITA TÉCNICA</p>
          <h1>{post.data.title}</h1>
          <p class="writing-article__description">{post.data.description}</p>
          <div class="writing-article__meta">
            <time datetime={post.data.pubDate.toISOString()}>
              Publicado em {post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' })}
            </time>
            <span>{readingMinutes} min de leitura</span>
            {post.data.updatedDate && <span>Atualizado em {post.data.updatedDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' })}</span>}
          </div>
          {post.data.tags.length > 0 && <ul class="writing-tags" aria-label="Assuntos do artigo">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
        </header>
        <div class="writing-article__body"><Content /></div>
        <footer class="writing-article__footer">
          <a class="text-link" href="/writing/">← Todos os artigos</a>
          <a class="text-link" href="/#contact">Contato profissional <span aria-hidden="true">↗</span></a>
        </footer>
      </div>
    </article>
  </main>
  <SiteFooter locale="pt-BR" />
</SiteLayout>
