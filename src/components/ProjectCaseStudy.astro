---
import type { projects } from '../data/site';

type Project = (typeof projects)[number];

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project">
  <div class="project__masthead">
    <p class="eyebrow">{project.eyebrow}</p>
    <span class="project__index" aria-hidden="true">01 / 01</span>
  </div>
  <div class="project__intro">
    <div>
      <h3>{project.name}<span aria-hidden="true">↗</span></h3>
      <p class="project__summary">{project.summary}</p>
    </div>
    <div class="project__links">
      <a
        href={project.website}
        target="_blank"
        rel="noreferrer"
        data-analytics-event="project_click"
      >Visitar o site <span aria-hidden="true">↗</span></a>
      <a
        href={project.repository}
        target="_blank"
        rel="noreferrer"
        data-analytics-event="project_click"
      >Ver repositório <span aria-hidden="true">↗</span></a>
    </div>
  </div>

  <div class="project__visual">
    <span class="project__visual-label">UMA BASE TÉCNICA, UM FLUXO EDITORIAL</span>
    <div class="architecture">
      <div class="architecture__node architecture__node--organizers">
        <span>01</span>
        <strong>Organizadores</strong>
        <small>Conteúdo e eventos</small>
      </div>
      <span class="architecture__connector" aria-hidden="true">→</span>
      <div class="architecture__node architecture__node--cms">
        <span>02</span>
        <strong>CMS editorial</strong>
        <small>Revisão no GitHub</small>
      </div>
      <span class="architecture__connector" aria-hidden="true">→</span>
      <div class="architecture__node architecture__node--site">
        <span>03</span>
        <strong>Site público</strong>
        <small>Astro · estático</small>
      </div>
    </div>
    <span class="project__visual-footnote">Fluxo de publicação do Talk BH</span>
  </div>

  <div class="project__details">
    <div class="project__narrative">
      <div>
        <p class="eyebrow">O DESAFIO</p>
        <p>{project.challenge}</p>
      </div>
      <div>
        <p class="eyebrow">A SOLUÇÃO</p>
        <p>{project.approach}</p>
      </div>
      <div>
        <p class="eyebrow">DECISÕES DE ENGENHARIA</p>
        <p>{project.engineering}</p>
      </div>
      <div>
        <p class="eyebrow">ACABAMENTO TÉCNICO</p>
        <p>{project.craftsmanship}</p>
      </div>
    </div>
    <dl class="project__stack">
      {
        project.details.map((detail) => (
          <div>
            <dt>{detail.label}</dt>
            <dd>{detail.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
  <p class="project__attribution">{project.contribution}</p>
</article>
