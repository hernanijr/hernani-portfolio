---
import { siteConfig } from '../data/site';
import type { Locale } from '../data/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'pt-BR' } = Astro.props;
const isEnglish = locale === 'en';
const prefix = isEnglish ? '/en/' : '/';
---

<footer class="site-footer">
  <div class="site-footer__main">
    <a class="wordmark wordmark--footer" href={prefix + '#top'}>
      <span class="wordmark__symbol" aria-hidden="true">h.</span>
      <span>{siteConfig.name}<small>{isEnglish ? 'SOFTWARE ENGINEERING' : 'ENGENHARIA DE SOFTWARE'}</small></span>
    </a>
    <p>{isEnglish
      ? 'Software engineer focused on backend development, APIs, and system integration.'
      : 'Engenheiro de software com foco em backend, APIs e integração de sistemas.'}</p>
    <div class="site-footer__links">
      <a href={isEnglish ? '/en/writing/' : '/writing/'}>Writing <span aria-hidden="true">↗</span></a>
      <a href={siteConfig.links.github} target="_blank" rel="noreferrer" data-analytics-event="github_click">GitHub <span aria-hidden="true">↗</span></a>
      <a href={siteConfig.links.linkedin} target="_blank" rel="noreferrer" data-analytics-event="linkedin_click">LinkedIn <span aria-hidden="true">↗</span></a>
      <a href={siteConfig.links.email} data-analytics-event="contact_click">E-mail <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="site-footer__legal">
    <span>© {new Date().getFullYear()} {siteConfig.name}. {isEnglish ? 'All rights reserved.' : 'Todos os direitos reservados.'}</span>
    <a href={prefix + '#top'}>{isEnglish ? 'Back to top' : 'Voltar ao início'} ↑</a>
  </div>
</footer>
