    <a class="wordmark" href="#top" aria-label="Hernani — início">
      <span class="wordmark__symbol" aria-hidden="true">h.</span>
      <span>{siteConfig.name}<small>ENGENHARIA DE SOFTWARE</small></span>
    </a>
    <nav aria-label="Navegação principal">
      <a href="#about">Sobre</a>
      <a href="#services">Soluções</a>
      <a href="#projects">Projetos</a>
      <a class="site-header__contact" href="#contact" data-analytics-event="contact_click">
        Vamos conversar <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>
