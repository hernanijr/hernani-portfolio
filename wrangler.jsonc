{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hernani-portfolio",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist"
  },
  "preview_urls": true,
  "previews": {},
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
